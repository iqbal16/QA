{
  "name": "WDIO_Bal",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.23.2",
    "@wdio/cli": "^9.23.2",
    "@wdio/cucumber-framework": "^9.23.2",
    "@wdio/local-runner": "^9.23.2",
    "@wdio/spec-reporter": "^9.23.2",
    "allure-commandline": "^2.36.0"
  },
"scripts": {
  "test": "wdio run ./wdio.conf.js",
  "test:login": "wdio run ./wdio.conf.js --spec features/login.feature",
  "allure:generate": "allure generate allure-results --clean -o allure-report",
  "allure:open": "allure open allure-report",
  "report": "npm run allure:generate && npm run allure:open"
}
}
  